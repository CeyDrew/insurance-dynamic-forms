{
  "id": "casco-risk",
  "version": 1,
  "title": "Kasko Risk Formu",
  "description": "Aracınız ve kullanımı hakkında birkaç soru. Teklif bu bilgilere göre hesaplanır.",
  "steps": [
    {
      "id": "vehicle",
      "title": "Araç Bilgileri",
      "fields": [
        {
          "id": "plate",
          "type": "text",
          "label": "Plaka",
          "placeholder": "34ABC123",
          "hint": "Boşluk kullanmadan, büyük harfle yazın.",
          "required": true,
          "validators": [
            { "type": "pattern", "value": "^(0[1-9]|[1-7][0-9]|8[01])[A-Z]{1,3}[0-9]{2,4}$", "message": "Geçersiz plaka" }
          ]
        },
        {
          "id": "brand",
          "type": "select",
          "label": "Marka",
          "required": true,
          "optionsSource": { "type": "remote", "url": "/api/lookups/vehicle-brands" }
        },
        {
          "id": "modelYear",
          "type": "number",
          "label": "Model Yılı",
          "required": true,
          "validators": [
            { "type": "min", "value": 1980, "message": "1980 öncesi araçlar için şubeye başvurun" },
            { "type": "max", "value": 2027 }
          ]
        },
        {
          "id": "vehicleAge",
          "type": "computed",
          "label": "Araç Yaşı",
          "expression": "currentYear() - modelYear",
          "format": "number"
        },
        {
          "id": "usageType",
          "type": "radio",
          "label": "Kullanım Şekli",
          "required": true,
          "defaultValue": "private",
          "options": [
            { "value": "private", "label": "Hususi" },
            { "value": "commercial", "label": "Ticari" },
            { "value": "taxi", "label": "Taksi / Dolmuş" }
          ]
        },
        {
          "id": "fuelType",
          "type": "select",
          "label": "Yakıt Tipi",
          "required": true,
          "options": [
            { "value": "gasoline", "label": "Benzin" },
            { "value": "diesel", "label": "Dizel" },
            { "value": "hybrid", "label": "Hibrit" },
            { "value": "electric", "label": "Elektrik" }
          ]
        },
        {
          "id": "hasLpg",
          "type": "boolean",
          "label": "Araçta LPG var mı?",
          "defaultValue": false,
          "visibleWhen": "fuelType == 'gasoline'"
        },
        {
          "id": "lpgBrand",
          "type": "select",
          "label": "LPG Marka",
          "optionsSource": { "type": "remote", "url": "/api/lookups/lpg-brands" },
          "visibleWhen": "hasLpg == true",
          "requiredWhen": "hasLpg == true"
        },
        {
          "id": "vehicleValue",
          "type": "currency",
          "label": "Araç Kasko Değeri",
          "currency": "TRY",
          "required": true,
          "validators": [{ "type": "min", "value": 50000 }]
        }
      ]
    },
    {
      "id": "driversStep",
      "title": "Sürücüler",
      "fields": [
        {
          "id": "driversInfo",
          "type": "info",
          "label": "Bilgi",
          "content": "Aracı düzenli kullanan tüm sürücüleri ekleyin. 25 yaş altı sürücüler primi etkiler."
        },
        {
          "id": "drivers",
          "type": "repeater",
          "label": "Sürücü Listesi",
          "itemLabel": "Sürücü",
          "addLabel": "Sürücü ekle",
          "required": true,
          "validators": [{ "type": "maxItems", "value": 5 }],
          "fields": [
            { "id": "driverName", "type": "text", "label": "Ad Soyad", "required": true,
              "validators": [{ "type": "maxLength", "value": 100 }] },
            { "id": "driverBirthDate", "type": "date", "label": "Doğum Tarihi", "required": true,
              "validators": [{ "type": "maxDate", "value": "today" }] },
            { "id": "driverAge", "type": "computed", "label": "Yaş", "expression": "age(driverBirthDate)" },
            { "id": "licenseYear", "type": "number", "label": "Ehliyet Alış Yılı", "required": true,
              "validators": [{ "type": "min", "value": 1950 }, { "type": "max", "value": 2027 }] },
            { "id": "youngDriverNote", "type": "info", "label": "Genç sürücü",
              "content": "25 yaş altı sürücü için ek prim uygulanır.",
              "visibleWhen": "driverAge < 25" }
          ]
        }
      ]
    },
    {
      "id": "history",
      "title": "Hasar Geçmişi",
      "fields": [
        { "id": "hadClaims", "type": "boolean", "label": "Son 3 yılda hasar kaydınız oldu mu?", "required": true },
        {
          "id": "claimCount",
          "type": "number",
          "label": "Hasar Sayısı",
          "visibleWhen": "hadClaims == true",
          "requiredWhen": "hadClaims == true",
          "validators": [{ "type": "min", "value": 1 }, { "type": "max", "value": 20 }]
        },
        {
          "id": "previousInsurer",
          "type": "select",
          "label": "Önceki Sigorta Şirketi",
          "hint": "İlk kez kasko yaptırıyorsanız boş bırakın.",
          "optionsSource": { "type": "remote", "url": "/api/lookups/insurers" }
        },
        {
          "id": "previousPolicyNo",
          "type": "text",
          "label": "Önceki Poliçe No",
          "visibleWhen": "!isEmpty(previousInsurer)",
          "requiredWhen": "!isEmpty(previousInsurer)"
        }
      ]
    },
    {
      "id": "coverage",
      "title": "Teminat",
      "fields": [
        {
          "id": "coverageType",
          "type": "radio",
          "label": "Kasko Türü",
          "required": true,
          "options": [
            { "value": "full", "label": "Tam Kasko" },
            { "value": "limited", "label": "Dar Kasko" }
          ]
        },
        {
          "id": "extras",
          "type": "multiselect",
          "label": "Ek Teminatlar",
          "visibleWhen": "coverageType == 'full'",
          "options": [
            { "value": "glass", "label": "Cam" },
            { "value": "miniRepair", "label": "Mini Onarım" },
            { "value": "replacementCar", "label": "İkame Araç" },
            { "value": "personalAccident", "label": "Ferdi Kaza" }
          ],
          "validators": [{ "type": "maxItems", "value": 4 }]
        },
        {
          "id": "startDate",
          "type": "date",
          "label": "Poliçe Başlangıç Tarihi",
          "required": true,
          "validators": [{ "type": "minDate", "value": "today", "message": "Geçmiş tarihli poliçe başlatılamaz" }]
        },
        { "id": "notes", "type": "textarea", "label": "Notlar", "rows": 3,
          "validators": [{ "type": "maxLength", "value": 500 }] }
      ]
    }
  ]
}
