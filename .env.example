# Copy to .env and fill in. .env is git-ignored.

# Oracle container (gvenzl/oracle-free)
ORACLE_PASSWORD=change-me
APP_DB_USER=forms
APP_DB_PASSWORD=change-me

# Backend connection (host port 1522 avoids clashing with other local Oracle on 1521)
ORACLE_HOST=localhost
ORACLE_PORT=1522
ORACLE_SERVICE=FREEPDB1
